# Supabase — Session pooler (port 5432). Koristi se za migracije i za Express server.
# Dashboard → Connect → ORMs → Prisma, ili Connection string → Session pooler.
# Zameni [LOZINKA] lozinkom koju uneseš pri kreiranju projekta.
DIRECT_URL="postgresql://postgres.XXXXXXXX:[LOZINKA]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Ista adresa za sada (dugovečni Node server, nije serverless).
# Kasnije za Vercel/serverless može Transaction pooler :6543?pgbouncer=true
DATABASE_URL="postgresql://postgres.XXXXXXXX:[LOZINKA]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

DB_PROVIDER="postgresql"

JWT_SECRET="promeni-ovo-u-dugacak-nasumican-string"

PORT=4000

FRONTEND_ORIGIN="*"

# Supabase Storage (foto / potpis). Bez ovoga prilozi se privremeno čuvaju u bazi.
# Dashboard → Project Settings → API → Project URL + service_role key
SUPABASE_URL="https://XXXX.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tvoj-service-role-key"
SUPABASE_STORAGE_BUCKET="nalog-prilozi"

# Email podsetnici (opciono)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="tvoj@gmail.com"
# SMTP_PASS="app-password"
# SMTP_FROM="Servis Dispecer <tvoj@gmail.com>"
# SMTP_SECURE="false"
